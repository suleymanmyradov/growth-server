syntax = "v1"

type (
	EmptyResponse  {}

	PageResponse {
		total      int64 `json:"total,example=100"`
		page       int   `json:"page,example=1"`
		limit      int   `json:"limit,example=20"`
		totalPages int   `json:"totalPages,example=5"`
	}
)

type (
	ArticleCategory {
		id   string `json:"id,example=cat-123"`
		name string `json:"name,example=Personal Development"`
		slug string `json:"slug,example=personal-development"`
	}

	Article {
		id          string           `json:"id,example=article-123"`
		title       string           `json:"title,example=10 Habits for Personal Growth"`
		excerpt     string           `json:"excerpt,example=Discover the top habits that can transform your life..."`
		content     string           `json:"content,example=Full article content here..."`
		category    *ArticleCategory `json:"category,optional"`
		readTime    int              `json:"readTime,example=5"`
		imageUrl    string           `json:"imageUrl,example=https://example.com/article.jpg"`
		author      string           `json:"author,example=John Smith"`
		publishedAt string           `json:"publishedAt,example=2024-01-01T00:00:00Z"`
		createdAt   string           `json:"createdAt,example=2024-01-01T00:00:00Z"`
		updatedAt   string           `json:"updatedAt,example=2024-01-15T00:00:00Z"`
		isSaved     bool             `json:"isSaved"`
		likeCount   int              `json:"likeCount"`
		isLiked     bool             `json:"isLiked"`
		tags        []string          `json:"tags,optional"`
		status      string           `json:"status,example=published"`
	}

	Tag {
		id   string `json:"id,example=tag-123"`
		name string `json:"name,example=productivity"`
		slug string `json:"slug,example=productivity"`
	}

	TagsResponse {
		data []Tag `json:"data"`
	}

	TagResponse {
		data Tag `json:"data"`
	}

	CreateTagRequest {
		name string `json:"name,example=productivity"`
		slug string `json:"slug,optional,example=productivity"`
	}

	UpdateTagRequest {
		id   string `path:"id"`
		name string `json:"name,example=productivity"`
		slug string `json:"slug,optional,example=productivity"`
	}

	Category {
		id        string `json:"id,example=cat-123"`
		name      string `json:"name,example=Personal Development"`
		slug      string `json:"slug,example=personal-development"`
		sortOrder int    `json:"sortOrder,example=1"`
		createdAt string `json:"createdAt,example=2024-01-01T00:00:00Z"`
		updatedAt string `json:"updatedAt,example=2024-01-15T00:00:00Z"`
	}

	CategoriesResponse {
		data []Category `json:"data"`
	}

	CategoryResponse {
		data Category `json:"data"`
	}

	ListCategoriesRequest {
		entityType string `form:"entityType,optional"`
	}

	CreateCategoryRequest {
		name      string `json:"name,example=Personal Development"`
		slug      string `json:"slug,optional,example=personal-development"`
		sortOrder int    `json:"sortOrder,optional"`
	}

	UpdateCategoryRequest {
		id        string `path:"id"`
		name      string `json:"name,example=Personal Development"`
		slug      string `json:"slug,optional,example=personal-development"`
		sortOrder int    `json:"sortOrder,optional"`
	}

	ReorderCategoriesRequest {
		ids        []string `json:"ids"`
		sortOrders []int    `json:"sortOrders"`
	}

	ArticleResponse {
		data Article `json:"data"`
	}

	ArticlesResponse {
		data []Article    `json:"data"`
		page PageResponse `json:"page"`
	}

	ArticleRequest {
		id string `path:"id"`
	}

	ListArticlesRequest {
		categorySlug string `form:"category,optional"`
		search       string `form:"search,optional"`
		status       string `form:"status,optional"`
		page         int    `form:"page,default=1"`
		limit        int    `form:"limit,default=20"`
	}

	CreateArticleRequest {
		title      string   `json:"title,example=10 Habits for Personal Growth"`
		content    string   `json:"content,example=Full article content here..."`
		summary    string   `json:"summary,optional"`
		authorId   string   `json:"authorId,example=user-123"`
		coverImage string   `json:"coverImage,optional,example=https://example.com/article.jpg"`
		tags       []string `json:"tags,optional"`
		readTime   int      `json:"readTime,example=5"`
		categoryId string   `json:"categoryId,optional,example=cat-123"`
		status     string   `json:"status,optional,example=published"`
	}

	UpdateArticleRequest {
		id         string   `path:"id"`
		title      string   `json:"title,optional"`
		content    string   `json:"content,optional"`
		summary    string   `json:"summary,optional"`
		authorId   string   `json:"authorId,optional"`
		coverImage string   `json:"coverImage,optional"`
		tags       []string `json:"tags,optional"`
		readTime   int      `json:"readTime,optional"`
		categoryId string   `json:"categoryId,optional"`
		status     string   `json:"status,optional,example=published"`
	}
)

type (
	LoginRequest {
		email    string `json:"email"`
		password string `json:"password"`
	}

	RefreshTokenRequest {
		refreshToken string `json:"refreshToken"`
	}

	UserInfo {
		id       string `json:"id"`
		email    string `json:"email"`
		fullName string `json:"fullName"`
		role     string `json:"role"`
	}

	AuthResponse {
		accessToken  string   `json:"accessToken"`
		refreshToken string   `json:"refreshToken"`
		user         UserInfo `json:"user"`
	}

	UploadImageRequest  {}

	UploadImageResponse {
		url string `json:"url"`
		key string `json:"key"`
	}
)

// SiteSettings types — admin-managed key/value store for site-wide config.
type (
	SiteSettingItem {
		key       string `json:"key,example=explore.header"`
		value     string `json:"value,example={\"title\":\"Explore\"}"`
		updatedAt string `json:"updatedAt,example=2024-01-15T00:00:00Z"`
	}

	SiteSettingResponse {
		data SiteSettingItem `json:"data"`
	}

	SiteSettingsResponse {
		data []SiteSettingItem `json:"data"`
	}

	UpsertSiteSettingRequest {
		key   string `json:"key,example=explore.header"`
		value string `json:"value,example={\"title\":\"Explore\"}"`
	}

	DeleteSiteSettingRequest {
		key string `path:"key"`
	}
)

// Habit & Goal Template types — admin-managed suggestion library shown on the explore page.
type (
	TemplateCategory {
		id   string `json:"id,optional"`
		name string `json:"name,optional"`
		slug string `json:"slug,optional"`
	}

	HabitTemplateItem {
		id          string            `json:"id"`
		name        string            `json:"name"`
		description string            `json:"description,optional"`
		category    *TemplateCategory `json:"category,optional"`
		sortOrder   int32             `json:"sortOrder"`
		isActive    bool              `json:"isActive"`
		createdAt   string            `json:"createdAt"`
		updatedAt   string            `json:"updatedAt"`
	}

	HabitTemplateResponse {
		data HabitTemplateItem `json:"data"`
	}

	HabitTemplatesResponse {
		data []HabitTemplateItem `json:"data"`
	}

	GetHabitTemplateRequest {
		id string `path:"id"`
	}

	CreateHabitTemplateRequest {
		name        string  `json:"name"`
		description string  `json:"description,optional"`
		categoryId  *string `json:"categoryId,optional"`
		sortOrder   int32   `json:"sortOrder,optional"`
		isActive    bool    `json:"isActive,optional"`
	}

	UpdateHabitTemplateRequest {
		id          string  `path:"id"`
		name        string  `json:"name"`
		description string  `json:"description,optional"`
		categoryId  *string `json:"categoryId,optional"`
		sortOrder   int32   `json:"sortOrder,optional"`
		isActive    bool    `json:"isActive,optional"`
	}

	DeleteHabitTemplateRequest {
		id string `path:"id"`
	}

	GoalTemplateItem {
		id          string            `json:"id"`
		title       string            `json:"title"`
		description string            `json:"description,optional"`
		category    *TemplateCategory `json:"category,optional"`
		sortOrder   int32             `json:"sortOrder"`
		isActive    bool              `json:"isActive"`
		createdAt   string            `json:"createdAt"`
		updatedAt   string            `json:"updatedAt"`
	}

	GoalTemplateResponse {
		data GoalTemplateItem `json:"data"`
	}

	GoalTemplatesResponse {
		data []GoalTemplateItem `json:"data"`
	}

	GetGoalTemplateRequest {
		id string `path:"id"`
	}

	CreateGoalTemplateRequest {
		title       string  `json:"title"`
		description string  `json:"description,optional"`
		categoryId  *string `json:"categoryId,optional"`
		sortOrder   int32   `json:"sortOrder,optional"`
		isActive    bool    `json:"isActive,optional"`
	}

	UpdateGoalTemplateRequest {
		id          string  `path:"id"`
		title       string  `json:"title"`
		description string  `json:"description,optional"`
		categoryId  *string `json:"categoryId,optional"`
		sortOrder   int32   `json:"sortOrder,optional"`
		isActive    bool    `json:"isActive,optional"`
	}

	DeleteGoalTemplateRequest {
		id string `path:"id"`
	}
)

// Report types — admin-managed user-submitted reports (bugs, feedback, abuse).
type (
	ReportItem {
		id          string `json:"id"`
		reporterId  string `json:"reporterId"`
		targetId    string `json:"targetId,optional"`
		targetType  string `json:"targetType"`
		category    string `json:"category"`
		title       string `json:"title"`
		description string `json:"description"`
		email       string `json:"email,optional"`
		status      string `json:"status"`
		adminNotes  string `json:"adminNotes,optional"`
		closeReason string `json:"closeReason,optional"`
		attachments []string `json:"attachments,optional"`
		createdAt   string `json:"createdAt"`
		updatedAt   string `json:"updatedAt"`
	}

	ReportCommentItem {
		id        string `json:"id"`
		reportId  string `json:"reportId"`
		userId    string `json:"userId"`
		comment   string `json:"comment"`
		isAdmin   bool   `json:"isAdmin"`
		createdAt string `json:"createdAt"`
	}

	ReportsResponse {
		data []ReportItem  `json:"data"`
		page PageResponse  `json:"page"`
	}

	ReportResponse {
		data ReportItem `json:"data"`
	}

	ReportCommentsResponse {
		data []ReportCommentItem `json:"data"`
	}

	ListReportsRequest {
		status   string `form:"status,optional"`
		category string `form:"category,optional"`
		page     int    `form:"page,default=1"`
		limit    int    `form:"limit,default=20"`
	}

	ReportIdRequest {
		id string `path:"id"`
	}

	UpdateReportRequest {
		id         string `path:"id"`
		status     string `json:"status"`
		adminNotes string `json:"adminNotes,optional"`
	}

	CloseReportRequest {
		id     string `path:"id"`
		reason string `json:"reason,optional"`
	}

	AddReportCommentRequest {
		id      string `path:"id"`
		comment string `json:"comment"`
	}

	AddReportCommentResponse {
		data ReportCommentItem `json:"data"`
	}
)



// Admin Notifications — broadcast a notification to a segmented audience.
type (
	// BroadcastNotificationRequest sends a notification to a user segment.
	// segment: "all" | "premium" | "free". Delivery is asynchronous via Kafka;
	// the response returns the resolved audience size and chunk count, not a
	// per-user delivery confirmation.
	BroadcastNotificationRequest {
		title    string `json:"title,example=New feature available"`
		message  string `json:"message,example=Weekly reviews now support..."`
		// itemType must be one of the notifications table allowed types; broadcasts
		// typically use "system".
		itemType string `json:"itemType,example=system"`
		segment  string `json:"segment,example=all"`
	}

	BroadcastNotificationResponse {
		broadcastID  string `json:"broadcastId"`
		audienceSize int    `json:"audienceSize"`
		chunks       int    `json:"chunks"`
	}
)

// Admin Metrics — analytics dashboard endpoints.
type (
	// MetricsRequest queries analytics rollup tables for a date range.
	// Both fromDate and toDate are optional (YYYY-MM-DD); omitting both
	// returns the last 30 days by default.
	MetricsRequest {
		fromDate string `json:"fromDate,optional"`
		toDate   string `json:"toDate,optional"`
	}

	// ActivationMetricsResponse returns activation funnel metrics.
	ActivationMetricsResponse {
		activated      int64   `json:"activated"`
		totalOnboarded int64   `json:"totalOnboarded"`
		activationRate float64 `json:"activationRate"`
		lifecycle      []LifecycleCount `json:"lifecycle"`
	}

	LifecycleCount {
		eventType string `json:"eventType"`
		count     int64  `json:"count"`
	}

	// RetentionMetricsResponse returns cohort retention data.
	RetentionMetricsResponse {
		cohorts []RetentionCohort `json:"cohorts"`
	}

	RetentionCohort {
		cohortDate     string  `json:"cohortDate"`
		cohortSize     int64   `json:"cohortSize"`
		periodDays     int32   `json:"periodDays"`
		retainedCount  int64   `json:"retainedCount"`
		retentionRate  float64 `json:"retentionRate"`
	}

	// BehaviorMetricsResponse returns daily behavioral metrics.
	BehaviorMetricsResponse {
		metrics []DailyMetric `json:"metrics"`
	}

	DailyMetric {
		date        string `json:"date"`
		metricName  string `json:"metricName"`
		metricValue int64  `json:"metricValue"`
	}

	// MonetizationMetricsResponse returns conversion funnel data.
	MonetizationMetricsResponse {
		funnel []ConversionStage `json:"funnel"`
	}

	ConversionStage {
		stage string `json:"stage"`
		count int64  `json:"count"`
	}
)
