syntax = "v1"

info (
	title:    "Admin API"
	desc:     "Admin panel API for managing articles, users, and content"
	author:   "suleymanmyradov"
	version:  "v1.0"
	schemes:  "http"
	host:     "localhost"
	basePath: "/api/v1"
)

import "types.api"

@server (
	prefix:     /api/v1/admin
	group:      articles
	middleware: Auth,AdminAuth
	tags:       "Admin Articles"
)
service adminapi {
	@handler AdminListArticles
	get /articles (ListArticlesRequest) returns (ArticlesResponse)

	@handler AdminGetArticle
	get /articles/:id (ArticleRequest) returns (ArticleResponse)

	@handler AdminCreateArticle
	post /articles (CreateArticleRequest) returns (ArticleResponse)

	@handler AdminUploadArticleImage
	post /files/upload-image (UploadImageRequest) returns (UploadImageResponse)
}

@server (
	prefix:     /api/v1/admin
	group:      articles
	middleware: Auth,AdminAuth
	tags:       "Admin Articles"
)
service adminapi {
	@handler AdminUpdateArticle
	put /articles/:id (UpdateArticleRequest) returns (ArticleResponse)

	@handler AdminDeleteArticle
	delete /articles/:id (ArticleRequest) returns (EmptyResponse)
}

@server (
	prefix:     /api/v1/admin
	group:      articles
	middleware: Auth,AdminAuth
	tags:       "Admin Articles"
)
service adminapi {
	@handler AdminListTags
	get /tags returns (TagsResponse)
}

@server (
	prefix:     /api/v1/admin
	group:      tags
	middleware: Auth,AdminAuth
	tags:       "Admin Tags"
)
service adminapi {
	@handler AdminCreateTag
	post /tags (CreateTagRequest) returns (TagResponse)

	@handler AdminUpdateTag
	put /tags/:id (UpdateTagRequest) returns (TagResponse)

	@handler AdminDeleteTag
	delete /tags/:id (ArticleRequest) returns (EmptyResponse)
}

@server (
	prefix:     /api/v1/admin
	group:      categories
	middleware: Auth,AdminAuth
	tags:       "Admin Categories"
)
service adminapi {
	@handler AdminListCategories
	get /categories (ListCategoriesRequest) returns (CategoriesResponse)

	@handler AdminCreateCategory
	post /categories (CreateCategoryRequest) returns (CategoryResponse)

	@handler AdminUpdateCategory
	put /categories/:id (UpdateCategoryRequest) returns (CategoryResponse)

	@handler AdminDeleteCategory
	delete /categories/:id (ArticleRequest) returns (EmptyResponse)

	@handler AdminReorderCategories
	post /categories/reorder (ReorderCategoriesRequest) returns (EmptyResponse)
}

// No public /auth/register: admin accounts are provisioned by inserting into
// internal_users (see sql/migrations_v2/025_internal_users.up.sql for the
// bootstrap procedure). Self-registration would let anyone mint admin tokens.
@server (
	prefix: /api/v1/admin
	group:  auth
	tags:   "Admin Auth"
)
service adminapi {
	@handler AuthLogin
	post /auth/login (LoginRequest) returns (AuthResponse)

	@handler AuthRefresh
	post /auth/refresh (RefreshTokenRequest) returns (AuthResponse)
}

@server (
	prefix:     /api/v1/admin
	group:      sitesettings
	middleware: Auth,AdminAuth
	tags:       "Admin Site Settings"
)
service adminapi {
	@handler AdminListSiteSettings
	get /site-settings returns (SiteSettingsResponse)

	@handler AdminGetSiteSetting
	get /site-settings/:key (DeleteSiteSettingRequest) returns (SiteSettingResponse)

	@handler AdminUpsertSiteSetting
	put /site-settings (UpsertSiteSettingRequest) returns (SiteSettingResponse)

	@handler AdminDeleteSiteSetting
	delete /site-settings/:key (DeleteSiteSettingRequest) returns (EmptyResponse)
}

@server (
	prefix:     /api/v1/admin
	group:      habittemplates
	middleware: Auth,AdminAuth
	tags:       "Admin Habit Templates"
)
service adminapi {
	@handler AdminListHabitTemplates
	get /habit-templates returns (HabitTemplatesResponse)

	@handler AdminGetHabitTemplate
	get /habit-templates/:id (GetHabitTemplateRequest) returns (HabitTemplateResponse)

	@handler AdminCreateHabitTemplate
	post /habit-templates (CreateHabitTemplateRequest) returns (HabitTemplateResponse)

	@handler AdminUpdateHabitTemplate
	put /habit-templates/:id (UpdateHabitTemplateRequest) returns (HabitTemplateResponse)

	@handler AdminDeleteHabitTemplate
	delete /habit-templates/:id (DeleteHabitTemplateRequest) returns (EmptyResponse)
}

@server (
	prefix:     /api/v1/admin
	group:      goaltemplates
	middleware: Auth,AdminAuth
	tags:       "Admin Goal Templates"
)
service adminapi {
	@handler AdminListGoalTemplates
	get /goal-templates returns (GoalTemplatesResponse)

	@handler AdminGetGoalTemplate
	get /goal-templates/:id (GetGoalTemplateRequest) returns (GoalTemplateResponse)

	@handler AdminCreateGoalTemplate
	post /goal-templates (CreateGoalTemplateRequest) returns (GoalTemplateResponse)

	@handler AdminUpdateGoalTemplate
	put /goal-templates/:id (UpdateGoalTemplateRequest) returns (GoalTemplateResponse)

	@handler AdminDeleteGoalTemplate
	delete /goal-templates/:id (DeleteGoalTemplateRequest) returns (EmptyResponse)
}

@server (
	prefix:     /api/v1/admin
	group:      reports
	middleware: Auth,AdminAuth
	tags:       "Admin Reports"
)
service adminapi {
	@handler AdminListReports
	get /reports (ListReportsRequest) returns (ReportsResponse)

	@handler AdminGetReport
	get /reports/:id (ReportIdRequest) returns (ReportResponse)

	@handler AdminUpdateReport
	put /reports/:id (UpdateReportRequest) returns (ReportResponse)

	@handler AdminCloseReport
	post /reports/:id/close (CloseReportRequest) returns (ReportResponse)

	@handler AdminListReportComments
	get /reports/:id/comments (ReportIdRequest) returns (ReportCommentsResponse)

	@handler AdminAddReportComment
	post /reports/:id/comments (AddReportCommentRequest) returns (AddReportCommentResponse)
}

@server (
	prefix:     /api/v1/admin
	group:      notifications
	middleware: Auth,AdminAuth
	tags:       "Admin Notifications"
)
service adminapi {
	@handler AdminBroadcastNotification
	post /notifications/broadcast (BroadcastNotificationRequest) returns (BroadcastNotificationResponse)
}

@server (
	prefix:     /api/v1/admin
	group:      metrics
	middleware: Auth,AdminAuth
	tags:       "Admin Metrics"
)
service adminapi {
	@handler AdminGetActivationMetrics
	get /metrics/activation (MetricsRequest) returns (ActivationMetricsResponse)

	@handler AdminGetRetentionMetrics
	get /metrics/retention (MetricsRequest) returns (RetentionMetricsResponse)

	@handler AdminGetBehaviorMetrics
	get /metrics/behavior (MetricsRequest) returns (BehaviorMetricsResponse)

	@handler AdminGetMonetizationMetrics
	get /metrics/monetization (MetricsRequest) returns (MonetizationMetricsResponse)
}

