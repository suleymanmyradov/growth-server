# =============================================================================
# Production environment variables for evolella.com backend.
#
# Copy to .env.prod and fill in real values. NEVER commit .env.prod.
# Generate secrets with: openssl rand -hex 32
# =============================================================================

# --- Domain ---
API_DOMAIN=api.evolella.com
APP_URL=https://app.evolella.com
APP_DOMAIN=app.evolella.com
ADMIN_DOMAIN=admin.evolella.com

# --- PostgreSQL ---
POSTGRES_USER=growthmind
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=growthmind
POSTGRES_PORT=5432
# Used by Go services (go-zero conf.MustLoad env expansion):
POSTGRES_DATASOURCE=host=postgres port=5432 user=growthmind dbname=growthmind password=CHANGE_ME_strong_password_here sslmode=disable
# Adminway uses a separate datasource string (same DB, different connection pool):
ADMIN_POSTGRES_DATASOURCE=host=postgres port=5432 user=growthmind dbname=growthmind password=CHANGE_ME_strong_password_here sslmode=disable

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# --- Meilisearch ---
MEILI_MASTER_KEY=CHANGE_ME_meili_master_key_here

# --- MinIO ---
MINIO_ACCESS_KEY=growthmind
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key_here

# --- JWT / Auth ---
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ISSUER=growth-auth
JWT_AUDIENCE=growth-api
# Service-to-service auth (different from JWT): openssl rand -hex 32
SERVICE_AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- Email (Resend) ---
RESEND_API_KEY=re_CHANGE_ME_your_resend_api_key
EMAIL_FROM_ADDRESS=noreply@evolella.com

# --- Google OAuth ---
GOOGLE_CLIENT_ID=874343812843-k9235ttvebor9mrlq8ie8vrnmreraq79.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-CHANGE_ME_your_google_oauth_secret

# --- Stripe Billing ---
BILLING_MODE=stripe_live
STRIPE_SECRET_KEY=sk_live_CHANGE_ME_your_stripe_live_secret_key
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_your_stripe_webhook_secret

# --- AI (Google AI Studio / Gemini) ---
AI_API_KEY=CHANGE_ME_your_google_ai_studio_api_key
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_SPEECH_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_STT_MODEL=gemini-3.1-flash-lite

# Primary models
AI_MODEL_CHEAP=gemini-flash-lite-latest
AI_MODEL_CHEAP_LONG=gemini-flash-latest
AI_MODEL_CLASSIFIER=gemini-flash-lite-latest
AI_MODEL_CHAT=gemini-flash-latest
AI_MODEL_FALLBACK=gemini-3.1-flash-lite

# Fallback provider 1 (gemini-3.5)
AI_FB1_CHEAP=gemini-3.5-flash-lite
AI_FB1_CHEAP_LONG=gemini-3.5-flash
AI_FB1_CLASSIFIER=gemini-3.5-flash-lite
AI_FB1_CHAT=gemini-3.5-flash
AI_FB1_FALLBACK=gemini-3.5-flash-lite

# Fallback provider 2 (gemini-3 / 3.1)
AI_FB2_CHEAP=gemini-3.1-flash-lite
AI_FB2_CHEAP_LONG=gemini-3-flash-preview
AI_FB2_CLASSIFIER=gemini-3.1-flash-lite
AI_FB2_CHAT=gemini-3-flash-preview
AI_FB2_FALLBACK=gemini-3.1-flash-lite

# Fallback provider 3 (Gemma-4, last resort)
AI_FB3_CHEAP=gemma-4-26b-a4b-it
AI_FB3_CHEAP_LONG=gemma-4-31b-it
AI_FB3_CLASSIFIER=gemma-4-26b-a4b-it
AI_FB3_CHAT=gemma-4-31b-it
AI_FB3_FALLBACK=gemma-4-26b-a4b-it
