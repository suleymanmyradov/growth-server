# =============================================================================
# Production environment variables for evolella.com backend.
#
# Copy to .env.prod and fill in real values. NEVER commit .env.prod.
# Generate secrets with: openssl rand -hex 32
# =============================================================================

# --- Domain ---
API_DOMAIN=api.evolella.com
APP_URL=https://app.evolella.com
APP_DOMAIN=app.evolella.com
ADMIN_DOMAIN=admin.evolella.com

# --- PostgreSQL ---
POSTGRES_USER=growthmind
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=growthmind
POSTGRES_PORT=5432
# Used by Go services (go-zero conf.MustLoad env expansion):
POSTGRES_DATASOURCE=host=postgres port=5432 user=growthmind dbname=growthmind password=CHANGE_ME_strong_password_here sslmode=disable
# Adminway uses a separate datasource string (same DB, different connection pool):
ADMIN_POSTGRES_DATASOURCE=host=postgres port=5432 user=growthmind dbname=growthmind password=CHANGE_ME_strong_password_here sslmode=disable

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# --- Meilisearch ---
MEILI_MASTER_KEY=CHANGE_ME_meili_master_key_here

# --- MinIO ---
MINIO_ACCESS_KEY=growthmind
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key_here

# --- JWT / Auth ---
# ES256 (asymmetric) signing. Generate keypairs with:
#   ./scripts/gen-jwt-keys.sh            → JWT_* pair   (user tokens)
#   ./scripts/gen-jwt-keys.sh ADMIN_JWT  → ADMIN_JWT_*  (admin tokens)
# PEMs are stored on ONE line with literal \n escapes.
#
# PUBLIC keys live here — this file is attached to every backend container
# (env_file: .env.prod), so it must never contain a private key.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ADMIN_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
#
# PRIVATE keys live in per-service env files attached to only ONE container:
#   deploy/.env.auth      → JWT_PRIVATE_KEY       (auth service only)
#   deploy/.env.adminway  → ADMIN_JWT_PRIVATE_KEY (adminway only)
# See .env.auth.example / .env.adminway.example.
JWT_ISSUER=growth-auth
JWT_AUDIENCE=growth-api
# Service-to-service auth (different from JWT): openssl rand -hex 32
SERVICE_AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- Email (Resend) ---
RESEND_API_KEY=re_CHANGE_ME_your_resend_api_key
EMAIL_FROM_ADDRESS=noreply@evolella.com

# --- Google OAuth ---
# Web client (secret required — exchanges the web authorization code).
GOOGLE_CLIENT_ID=874343812843-k9235ttvebor9mrlq8ie8vrnmreraq79.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-CHANGE_ME_your_google_oauth_secret
# Native client IDs (public — no secret). Audience allowlist for the mobile
# id_token verification path.
GOOGLE_IOS_CLIENT_ID=874343812843-5k4aog5i8ufm5uuab20qfl6121fpp9qf.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=874343812843-5ibmtn2esrmjgeadq0cammo1cjlse1p8.apps.googleusercontent.com

# --- Paddle Billing (web checkout) ---
# Live values from vendors.paddle.com: API key (Developer tools > Authentication),
# webhook secret (the pdl_ntfset_... shown when creating the notification
# destination for /api/v1/billing/paddle-webhook).
PADDLE_ENABLED=true
PADDLE_ENVIRONMENT=production
PADDLE_API_KEY=pdl_live_CHANGE_ME
PADDLE_WEBHOOK_SECRET=pdl_ntfset_CHANGE_ME
# Frontend build args — live client token (live_...) from Developer tools > Authentication.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_CHANGE_ME
NEXT_PUBLIC_PADDLE_ENV=production
# Live catalog price IDs (pri_...) — different from the sandbox IDs.
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=pri_CHANGE_ME
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEARLY=pri_CHANGE_ME

# --- OpenRouter (cross-provider AI fallback) ---
# Used when the primary Google AI requests fail (free-tier rate limits).
# Prepaid credits: fallback spend is bounded by the OpenRouter balance.
OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME_your_openrouter_key

# --- AI (Google AI Studio / Gemini) ---
AI_API_KEY=CHANGE_ME_your_google_ai_studio_api_key
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_SPEECH_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_STT_MODEL=gemini-3.1-flash-lite

# Primary models
AI_MODEL_CHEAP=gemini-flash-lite-latest
AI_MODEL_CHEAP_LONG=gemini-flash-latest
AI_MODEL_CLASSIFIER=gemini-flash-lite-latest
AI_MODEL_CHAT=gemini-flash-latest
AI_MODEL_FALLBACK=gemini-3.1-flash-lite

# Fallback provider 1 (gemini-3.5)
AI_FB1_CHEAP=gemini-3.5-flash-lite
AI_FB1_CHEAP_LONG=gemini-3.5-flash
AI_FB1_CLASSIFIER=gemini-3.5-flash-lite
AI_FB1_CHAT=gemini-3.5-flash
AI_FB1_FALLBACK=gemini-3.5-flash-lite

# Fallback provider 2 (gemini-3 / 3.1)
AI_FB2_CHEAP=gemini-3.1-flash-lite
AI_FB2_CHEAP_LONG=gemini-3-flash-preview
AI_FB2_CLASSIFIER=gemini-3.1-flash-lite
AI_FB2_CHAT=gemini-3-flash-preview
AI_FB2_FALLBACK=gemini-3.1-flash-lite

# Fallback provider 3 (Gemma-4, last resort)
AI_FB3_CHEAP=gemma-4-26b-a4b-it
AI_FB3_CHEAP_LONG=gemma-4-31b-it
AI_FB3_CLASSIFIER=gemma-4-26b-a4b-it
AI_FB3_CHAT=gemma-4-31b-it
AI_FB3_FALLBACK=gemma-4-26b-a4b-it

# --- Observability (monitoring profile) ---
# Grafana admin login (dashboards at localhost:3001 via SSH tunnel).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_password_here
# Set + uncomment the grafana block in deploy/caddy/Caddyfile to expose publicly.
#GRAFANA_DOMAIN=grafana.evolella.com

# --- Sentry (error tracking) ---
# Backend (growth-backend project) DSN — read from env by pkg/sentryx in
# all Go services; empty = disabled.
SENTRY_DSN=
# Optional: environment/release labels shown in Sentry issues.
SENTRY_ENVIRONMENT=production
# growth-web project DSN — inlined into the browser JS bundle at image
# build time AND used for the frontend's server-side capture. Also needed
# as a `NEXT_PUBLIC_SENTRY_DSN` repo secret in the self-dev repo so CI
# build-args can pass it.
NEXT_PUBLIC_SENTRY_DSN=
# growth-admin project DSN — same role for admin-frontend (repo secret
# `NEXT_PUBLIC_SENTRY_DSN` in growth-admin-front).
ADMIN_SENTRY_DSN=
