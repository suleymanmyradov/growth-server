# Attached ONLY to the adminway container (env_file in docker-compose.prod.yml).
# Holds the ES256 private key — adminway is the sole issuer of admin tokens
# (audience growth-admin). Generate: ./scripts/gen-jwt-keys.sh ADMIN_JWT
# Keep on one line with literal \n escapes.
ADMIN_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
