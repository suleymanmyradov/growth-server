# =============================================================================
# Non-secret config shared by all backend app containers (.env.shared).
#
# Attached to every service via env_file alongside its per-service .env.<svc>.
# This file must contain NO secrets — only values that are identical for every
# consumer (issuer/audience, PUBLIC keys, model names, feature flags).
#
# deploy/scripts/split-env.sh generates this from .env.prod automatically;
# this example documents which keys belong here. NEVER commit .env.shared.
# =============================================================================

APP_URL=https://app.evolella.com
# Public API origin with scheme — e.g. List-Unsubscribe URLs in emails that
# mail clients POST to directly.
API_BASE_URL=https://api.evolella.com

# JWT — public halves only (verify). Private keys live in .env.auth / .env.adminway.
JWT_ISSUER=growth-auth
JWT_AUDIENCE=growth-api
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ADMIN_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

EMAIL_FROM_ADDRESS=noreply@evolella.com

# Google OAuth public client IDs (the secret stays in .env.auth).
GOOGLE_CLIENT_ID=874343812843-k9235ttvebor9mrlq8ie8vrnmreraq79.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=874343812843-5k4aog5i8ufm5uuab20qfl6121fpp9qf.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=874343812843-5ibmtn2esrmjgeadq0cammo1cjlse1p8.apps.googleusercontent.com

# Billing feature flags (API keys/secrets live in .env.client).
PADDLE_ENABLED=true
PADDLE_ENVIRONMENT=production
REVENUECAT_ENABLED=true

# AI model routing config (the AI_API_KEY secret lives in
# .env.ai-coach / .env.ai-gateway / .env.ai-coach-consumer only).
# Pin exact versions, not *-latest aliases: the alias can drift to a
# thinking-tier variant that blows the 10s safety-classifier budget.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_SPEECH_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_STT_MODEL=gemini-3.1-flash-lite
AI_MODEL_CHEAP=gemini-3.1-flash-lite
AI_MODEL_CHEAP_LONG=gemini-flash-latest
AI_MODEL_CLASSIFIER=gemini-3.1-flash-lite
AI_MODEL_CHAT=gemini-flash-latest
AI_MODEL_FALLBACK=gemini-3.1-flash-lite
AI_FB1_CHEAP=gemini-3.5-flash-lite
AI_FB1_CHEAP_LONG=gemini-3.5-flash
AI_FB1_CLASSIFIER=gemini-3.5-flash-lite
AI_FB1_CHAT=gemini-3.5-flash
AI_FB1_FALLBACK=gemini-3.5-flash-lite
AI_FB2_CHEAP=gemini-3.1-flash-lite
AI_FB2_CHEAP_LONG=gemini-3-flash-preview
AI_FB2_CLASSIFIER=gemini-3.1-flash-lite
AI_FB2_CHAT=gemini-3-flash-preview
AI_FB2_FALLBACK=gemini-3.1-flash-lite
AI_FB3_CHEAP=gemma-4-26b-a4b-it
AI_FB3_CHEAP_LONG=gemma-4-31b-it
AI_FB3_CLASSIFIER=gemma-4-26b-a4b-it
AI_FB3_CHAT=gemma-4-31b-it
AI_FB3_FALLBACK=gemma-4-26b-a4b-it

# Public MinIO/S3 base for presigned URLs served through Caddy (/files/*).
MINIO_PUBLIC_BASE_URL=https://api.evolella.com/files

# Sentry — backend project DSN + label (safe to share; DSNs are write-only).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
