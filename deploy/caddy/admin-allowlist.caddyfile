# GENERATED by deploy/deploy.sh from ADMIN_ALLOWED_IPS — do not edit.
# Default (var unset): matcher matches a path that never occurs, so the admin
# panel stays reachable. Set ADMIN_ALLOWED_IPS in deploy/.env.prod to enable
# the allowlist (space- or comma-separated CIDRs).
@admin_forbidden {
	path /__admin_allowlist_disabled__
}
handle @admin_forbidden {
	respond "Forbidden" 403
}
