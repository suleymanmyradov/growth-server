# Caddy reverse proxy for evolella.com backend.
#
# Routes /api/v1/* to either gateway (CRUD) or ai-gateway (AI/streaming)
# based on the path. Both share the /api/v1 prefix — see the route table below.
#
# TLS is automatic via Let's Encrypt (Caddy provisions on first request).
# The domain is set from the ${API_DOMAIN} env var at container startup.

{$API_DOMAIN} {
	encode zstd gzip

	# Baseline security headers for every response from this site.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# --- AI-gateway routes (matched first) ---
	@ai_prefix {
		path /api/v1/conversations /api/v1/conversations/* /api/v1/memory/facts /api/v1/memory/facts/*
	}
	handle @ai_prefix {
		reverse_proxy ai-gateway:8889 {
			# Long timeouts for SSE streaming (coaching, voice).
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# Specific AI-gateway endpoints (exact paths, not whole prefix).
	@ai_exact {
		path \
			/api/v1/weekly-reviews/generate \
			/api/v1/weekly-reviews/generate-stream \
			/api/v1/personalization/coaching \
			/api/v1/personalization/coaching-stream \
			/api/v1/personalization/onboarding-habits \
			/api/v1/personalization/transcribe \
			/api/v1/personalization/voice-turn
	}
	handle @ai_exact {
		reverse_proxy ai-gateway:8889 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# Paddle webhook source-IP allowlist (generated file — refresh via
	# deploy/scripts/fetch-paddle-webhook-ips.sh). Its matcher is more specific
	# than /api/v1/*, so non-Paddle sources get 403 before reaching the gateway.
	import paddle-webhook-ips.caddyfile

	# --- Gateway (everything else under /api/v1) ---
	handle /api/v1/* {
		reverse_proxy gateway:8888
	}

	# --- Object storage (MinIO, path-style /bucket/key) ---
	# Serves ONLY SigV4-presigned URLs minted by the filemanager — presigned
	# requests always carry X-Amz-Signature in the query, so anything without
	# it falls through to the catch-all 404 and never reaches MinIO. The
	# bucket policy is also private (deploy/scripts/harden-minio.sh); this
	# matcher is defense in depth so a bad bucket policy alone cannot reopen
	# anonymous access. Do not add `mc anonymous` grants for this bucket.
	@files_presigned {
		path /files/*
		vars_regexp {http.request.uri.query} (^|&)X-Amz-Signature=[^&]
	}
	handle @files_presigned {
		uri strip_prefix /files
		reverse_proxy minio:9000
	}

	# --- Admin API (optional, on a subdomain or path) ---
	# Uncomment to expose adminway on /admin/api/*
	# handle /admin/api/* {
	# 	uri strip_prefix /admin/api
	# 	reverse_proxy adminway:8890
	# }

	# Health check endpoint
	handle /health {
		respond "ok" 200
	}

	# Default: 404 for non-API paths (Caddy is API-only, frontend is on a different host)
	handle {
		respond "Not Found" 404
	}
}

# User-facing Next.js app.
{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy frontend:3000
}

# Admin panel (Next.js admin-frontend → adminway API).
# Only resolvable when the `admin` compose profile is enabled; Caddy 502s otherwise.
# Source-IP allowlist generated from ADMIN_ALLOWED_IPS (deploy/.env.prod) by
# deploy.sh — when unset the generated matcher never matches (panel stays open).
{$ADMIN_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	import admin-allowlist.caddyfile

	reverse_proxy admin-frontend:3001
}

# Grafana dashboards (monitoring profile). Binds to localhost by default —
# access via SSH tunnel: ssh -L 3001:localhost:3001 root@<vm-ip>.
# To expose publicly: add a DNS record for grafana.<domain> in Cloudflare,
# set GRAFANA_DOMAIN in deploy/.env.prod, uncomment this block, and recreate
# caddy. Grafana's own login protects it — set a strong GF admin password.
#
